<?xml version="1.0" encoding="UTF-8" ?>
<!-- 容器内大图像传输：64 MiB 共享内存段，单消息上限 16 MiB。
     不修改宿主共享内存、socket 或 USB 参数。 -->
<profiles xmlns="http://www.eprosima.com/XMLSchemas/fastRTPS_Profiles">
  <transport_descriptors>
    <transport_descriptor>
      <transport_id>gemini_shm</transport_id>
      <type>SHM</type>
      <segment_size>67108864</segment_size>
      <maxMessageSize>16777216</maxMessageSize>
      <port_queue_capacity>512</port_queue_capacity>
    </transport_descriptor>
    <transport_descriptor>
      <transport_id>gemini_udp</transport_id>
      <type>UDPv4</type>
    </transport_descriptor>
  </transport_descriptors>
  <participant profile_name="gemini_default" is_default_profile="true">
    <rtps>
      <userTransports>
        <transport_id>gemini_shm</transport_id>
        <transport_id>gemini_udp</transport_id>
      </userTransports>
      <useBuiltinTransports>false</useBuiltinTransports>
    </rtps>
  </participant>
</profiles>
